
VITE_API_BASE=

VITE_ENABLE_ADAPTIVE=false

VITE_FIREBASE_API_KEY=TU_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=TU_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=TU_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=TU_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=TU_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=TU_APP_ID



DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres


FIREBASE_PROJECT_ID=TU_PROJECT_ID

# Judge0. modo=rapidapi 
JUDGE0_MODO=rapidapi
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
RAPIDAPI_KEY=TU_CLAVE_DE_RAPIDAPI
# Solo para JUDGE0_MODO=directo
JUDGE0_AUTH_TOKEN=

JUDGE0_MAX_DIARIO=400
JUDGE0_MAX_MENSUAL=4000


ALLOWED_ORIGINS=https://TU_PROJECT.web.app,http://localhost:5173

# Limites por peticion
JUDGE0_TIMEOUT_MS=15000
EVALUACION_DEADLINE_MS=100000
MAX_CASOS_POR_ENVIO=25
MAX_CODIGO_BYTES=65536
MAX_ENTRADA_BYTES=65536

# 51 C#, 54 C++, 62 Java, 63 JavaScript, 68 PHP, 71 Python
JUDGE0_LENGUAJES=51,54,62,63,68,71


ZONA_HORARIA=America/Bogota

# ── Tutor IA 
IA_API_KEY=TU_CLAVE_DE_DEEPINFRA
IA_URL=https://api.deepinfra.com/v1/openai
IA_MODELO=Qwen/Qwen3.6-35B-A3B

# Techo de gasto: tokens por respuesta y llamadas por dia/mes.
IA_MAX_TOKENS=400
IA_TIMEOUT_MS=25000
IA_MAX_DIARIO=200
IA_MAX_MENSUAL=2000
# Espera entre pistas del mismo estudiante (segundos).
IA_ESPERA_SEGUNDOS=60

# Recortes de la entrada, en caracteres.
IA_MAX_CODIGO=3500
IA_MAX_ENUNCIADO=1200
IA_MAX_ERROR=400

# ── Juez de PSeInt (Lambda en AWS)
PSEINT_LAMBDA_FUNCION=codecomp-pseint
PSEINT_LAMBDA_REGION=us-east-1
# Llave del usuario IAM que solo puede invocar la Lambda.
PSEINT_AWS_ACCESS_KEY_ID=TU_ACCESS_KEY_ID
PSEINT_AWS_SECRET_ACCESS_KEY=TU_SECRET_ACCESS_KEY
PSEINT_TIMEOUT_MS=12000
PSEINT_MAX_DIARIO=3000
PSEINT_MAX_MENSUAL=30000
# Espera entre envios y tope diario por estudiante.
PSEINT_ESPERA_SEGUNDOS=5
PSEINT_TOPE_DIARIO=200
